# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DBNAME=opence

# the port the server listens on
PORT=8082

# the time zone whose midnight ends each day's challenge (IANA name);
# empty: the server's own
HALO_DAILY_TIMEZONE=America/Mexico_City

# the management page (/admin) and PUT /daily/:day sign in with this
# (x-admin-code); empty: off
HALO_ADMIN_CODE=

# behind a reverse proxy: Express's trust proxy (true, or a hop count such as
# 1), so /admin's wrong codes are counted by the client's address; empty: off
TRUST_PROXY=
